{
  "name": "ebg",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "node server.js --bundled-catalog",
    "build": "vite build && node scripts/build-pwa.mjs",
    "start": "node server.js --production --bundled-catalog",
    "test": "node --test",
    "test:pwa": "node scripts/check-pwa.mjs",
    "test:dev": "node scripts/check-dev.mjs",
    "account:create": "node scripts/create-account.mjs",
    "accounts:setup": "node scripts/setup-accounts.mjs",
    "account:reset": "node scripts/reset-password.mjs",
    "test:operations": "npm run test:packing-production && npm run test:stock-work",
    "test:account-login": "node scripts/check-account-login.mjs",
    "test:packing-production": "node scripts/check-packing-production.mjs",
    "test:stock-work": "node scripts/check-stock-work.mjs",
    "test:webcam-qr": "node scripts/check-webcam-qr.mjs",
    "test:qr": "node scripts/check-qr.mjs",
    "firebase:emulators": "node ./node_modules/firebase-tools/lib/bin/firebase.js emulators:start --project demo-ebg --import=.firebase-data --export-on-exit=.firebase-data",
    "firebase:import": "node scripts/firebase-import.mjs",
    "firebase:deploy": "npm run build && node ./node_modules/firebase-tools/lib/bin/firebase.js deploy",
    "backup": "node scripts/backup-database.mjs",
    "backup:restore": "node scripts/restore-backup.mjs",
    "import:kho-ebg": "node scripts/import-kho-ebg.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Huynh7124/ebg.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/Huynh7124/ebg/issues"
  },
  "homepage": "https://github.com/Huynh7124/ebg#readme",
  "dependencies": {
    "@fontsource/be-vietnam-pro": "^5.3.0",
    "@fontsource/k2d": "^5.3.0",
    "bcryptjs": "^3.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "firebase": "^13.2.0",
    "helmet": "^8.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "firebase-admin": "^13.7.0",
    "firebase-tools": "^15.34.2",
    "vite": "^8.3.5"
  }
}
