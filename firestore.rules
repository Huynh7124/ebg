rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function managesWarehouse() {
      return signedIn() && role() in ['admin', 'warehouse'];
    }

    match /users/{userId} {
      allow read: if signedIn() && (userId == request.auth.uid || managesWarehouse());
      allow write: if managesWarehouse();
    }

    match /products/{productId} {
      allow read: if signedIn();
      // Stock-changing writes stay denied until the Firestore transaction layer is migrated.
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
