# Local Firebase Emulator. Copy to .env.local before running the emulator.
VITE_USE_FIREBASE_EMULATOR=true
VITE_FIREBASE_API_KEY=demo-ebg-key
VITE_FIREBASE_AUTH_DOMAIN=demo-ebg.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-ebg
VITE_FIREBASE_STORAGE_BUCKET=demo-ebg.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:local
